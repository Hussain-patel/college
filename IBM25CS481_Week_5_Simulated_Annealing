      "source": [
        "\n",
        "\n",
        "import math\n",
        "import random\n",
        "\n",
        "def calculate_cost(state):\n",
        "    conflicts = 0\n",
        "    n = len(state)\n",
        "    for i in range(n):\n",
        "        for j in range(i + 1, n):\n",
        "            if abs(i - j) == abs(state[i] - state[j]):\n",
        "                conflicts += 1\n",
        "    return conflicts\n",
        "\n",
        "def get_random_neighbor(state):\n",
        "    neighbor = list(state)\n",
        "    i, j = random.sample(range(len(state)), 2)\n",
        "    neighbor[i], neighbor[j] = neighbor[j], neighbor[i]\n",
        "    return neighbor\n",
        "\n",
        "def simulated_annealing(initial_state, initial_temp=100.0, cooling_rate=0.99):\n",
        "    current_state = initial_state\n",
        "    current_cost = calculate_cost(current_state)\n",
        "\n",
        "    T = initial_temp\n",
        "\n",
        "    while T > 0.01:\n",
        "        if current_cost == 0:\n",
        "            break\n",
        "\n",
        "        next_state = get_random_neighbor(current_state)\n",
        "        next_cost = calculate_cost(next_state)\n",
        "\n",
        "        delta_e = current_cost - next_cost\n",
        "\n",
        "        if delta_e > 0:\n",
        "            current_state = next_state\n",
        "            current_cost = next_cost\n",
        "        else:\n",
        "            probability = math.exp(delta_e / T)\n",
        "            if random.random() < probability:\n",
        "                current_state = next_state\n",
        "                current_cost = next_cost\n",
        "\n",
        "        T *= cooling_rate\n",
        "\n",
        "    return current_state, current_cost\n",
        "\n",
        "initial_state = list(range(8))\n",
        "random.shuffle(initial_state)\n",
        "\n",
        "print(f\"Initial State: {initial_state} | Initial Cost: {calculate_cost(initial_state)}\")\n",
        "final_state, final_cost = simulated_annealing(initial_state)\n",
        "print(f\"Final Configuration: {final_state} | Final Cost: {final_cost}\")\n",
        "if final_cost == 0:\n",
        "    print(\"Successfully found a solution!\")\n",
        "else:\n",
        "    print(\"Terminated without reaching perfect 0 cost. Try adjusting the cooling rate.\")\n",
        "\n"
      ]
