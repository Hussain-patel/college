GOAL = (
    1, 2, 3,
    8, 0, 4,
    7, 6, 5
)

POS = {
    n: divmod(i, 3)
    for i, n in enumerate(GOAL)
    if n != 0
}


def manhattan(state):
    return sum(
        abs(i // 3 - POS[n][0]) +
        abs(i % 3 - POS[n][1])
        for i, n in enumerate(state)
        if n != 0
    )


def neighbors(state):
    zero = state.index(0)
    row, col = divmod(zero, 3)

    moves = [
        (-1, 0),
        (1, 0),
        (0, -1),
        (0, 1)
    ]

    for dr, dc in moves:
        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:
            new_state = list(state)
            new_zero = new_row * 3 + new_col

            new_state[zero], new_state[new_zero] = (
                new_state[new_zero],
                new_state[zero]
            )

            yield tuple(new_state)


def inversions(state):
    tiles = [x for x in state if x != 0]

    return sum(
        tiles[i] > tiles[j]
        for i in range(len(tiles))
        for j in range(i + 1, len(tiles))
    )


def solvable(state):
    return (
        inversions(state) % 2
        == inversions(GOAL) % 2
    )


def hill_climbing(start):
    """
    Steepest-ascent hill climbing.
    At each step, look at all neighbors and move to the one with the
    lowest Manhattan distance. Stop when no neighbor is strictly better
    (goal reached, or stuck at a local minimum / plateau).
    Returns (path, reached_goal).
    """
    current = start
    path = [current]

    while current != GOAL:
        current_h = manhattan(current)

        best = min(neighbors(current), key=manhattan)
        best_h = manhattan(best)

        # No improvement -> local optimum or plateau
        if best_h >= current_h:
            return path, False

        current = best
        path.append(current)

    return path, True


def print_board(state):
    for i in range(0, 9, 3):
        print(
            " ".join(
                str(x) if x != 0 else " "
                for x in state[i:i + 3]
            )
        )

    print("-" * 9)


while True:
    try:
        state = tuple(
            map(int, input("Enter 9 numbers: ").split())
        )

        if len(state) == 9 and sorted(state) == list(range(9)):
            break

        print("Error: Enter numbers 0 to 8 exactly once.")

    except ValueError:
        print("Error: Enter integers only.")


print("\nInitial State:")
print_board(state)

print("Target Goal State:")
print_board(GOAL)

if not solvable(state):
    print("This puzzle configuration is UNSOLVABLE.")

else:
    print(
        "Solvability check passed! Solving using Hill Climbing "
        "(Manhattan Distance)...\n"
    )

    solution, reached = hill_climbing(state)

    if reached:
        print(
            f"Goal reached in {len(solution) - 1} steps!\n"
        )
    else:
        print(
            f"Stuck at a local optimum after {len(solution) - 1} steps "
            f"(h = {manhattan(solution[-1])}). Hill climbing failed.\n"
        )

    for step, s in enumerate(solution):
        print(f"Step {step}:")
        print_board(s)
