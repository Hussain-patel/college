          "name": "stdout",
          "text": [
            "Enter 9 numbers: 0 1 2 3 4 5 6 7 8 \n",
            "\n",
            "Initial State:\n",
            "  1 2\n",
            "3 4 5\n",
            "6 7 8\n",
            "---------\n",
            "Target Goal State:\n",
            "1 2 3\n",
            "8   4\n",
            "7 6 5\n",
            "---------\n",
            "This puzzle configuration is UNSOLVABLE.\n"
          ]
        }
      ],
      "source": [
        "GOAL = (\n",
        "    1, 2, 3,\n",
        "    8, 0, 4,\n",
        "    7, 6, 5\n",
        ")\n",
        "\n",
        "POS = {\n",
        "    n: divmod(i, 3)\n",
        "    for i, n in enumerate(GOAL)\n",
        "    if n != 0\n",
        "}\n",
        "\n",
        "\n",
        "def manhattan(state):\n",
        "    return sum(\n",
        "        abs(i // 3 - POS[n][0]) +\n",
        "        abs(i % 3 - POS[n][1])\n",
        "        for i, n in enumerate(state)\n",
        "        if n != 0\n",
        "    )\n",
        "\n",
        "\n",
        "def neighbors(state):\n",
        "    zero = state.index(0)\n",
        "    row, col = divmod(zero, 3)\n",
        "\n",
        "    moves = [\n",
        "        (-1, 0),\n",
        "        (1, 0),\n",
        "        (0, -1),\n",
        "        (0, 1)\n",
        "    ]\n",
        "\n",
        "    for dr, dc in moves:\n",
        "        new_row = row + dr\n",
        "        new_col = col + dc\n",
        "\n",
        "        if 0 <= new_row < 3 and 0 <= new_col < 3:\n",
        "            new_state = list(state)\n",
        "            new_zero = new_row * 3 + new_col\n",
        "\n",
        "            new_state[zero], new_state[new_zero] = (\n",
        "                new_state[new_zero],\n",
        "                new_state[zero]\n",
        "            )\n",
        "\n",
        "            yield tuple(new_state)\n",
        "\n",
        "\n",
        "def inversions(state):\n",
        "    tiles = [x for x in state if x != 0]\n",
        "\n",
        "    return sum(\n",
        "        tiles[i] > tiles[j]\n",
        "        for i in range(len(tiles))\n",
        "        for j in range(i + 1, len(tiles))\n",
        "    )\n",
        "\n",
        "\n",
        "def solvable(state):\n",
        "    return (\n",
        "        inversions(state) % 2\n",
        "        == inversions(GOAL) % 2\n",
        "    )\n",
        "\n",
        "\n",
        "def hill_climbing(start):\n",
        "    \"\"\"\n",
        "    Steepest-ascent hill climbing.\n",
        "    At each step, look at all neighbors and move to the one with the\n",
        "    lowest Manhattan distance. Stop when no neighbor is strictly better\n",
        "    (goal reached, or stuck at a local minimum / plateau).\n",
        "    Returns (path, reached_goal).\n",
        "    \"\"\"\n",
        "    current = start\n",
        "    path = [current]\n",
        "\n",
        "    while current != GOAL:\n",
        "        current_h = manhattan(current)\n",
        "\n",
        "        best = min(neighbors(current), key=manhattan)\n",
        "        best_h = manhattan(best)\n",
        "\n",
        "        # No improvement -> local optimum or plateau\n",
        "        if best_h >= current_h:\n",
        "            return path, False\n",
        "\n",
        "        current = best\n",
        "        path.append(current)\n",
        "\n",
        "    return path, True\n",
        "\n",
        "\n",
        "def print_board(state):\n",
        "    for i in range(0, 9, 3):\n",
        "        print(\n",
        "            \" \".join(\n",
        "                str(x) if x != 0 else \" \"\n",
        "                for x in state[i:i + 3]\n",
        "            )\n",
        "        )\n",
        "\n",
        "    print(\"-\" * 9)\n",
        "\n",
        "\n",
        "while True:\n",
        "    try:\n",
        "        state = tuple(\n",
        "            map(int, input(\"Enter 9 numbers: \").split())\n",
        "        )\n",
        "\n",
        "        if len(state) == 9 and sorted(state) == list(range(9)):\n",
        "            break\n",
        "\n",
        "        print(\"Error: Enter numbers 0 to 8 exactly once.\")\n",
        "\n",
        "    except ValueError:\n",
        "        print(\"Error: Enter integers only.\")\n",
        "\n",
        "\n",
        "print(\"\\nInitial State:\")\n",
        "print_board(state)\n",
        "\n",
        "print(\"Target Goal State:\")\n",
        "print_board(GOAL)\n",
        "\n",
        "if not solvable(state):\n",
        "    print(\"This puzzle configuration is UNSOLVABLE.\")\n",
        "\n",
        "else:\n",
        "    print(\n",
        "        \"Solvability check passed! Solving using Hill Climbing \"\n",
        "        \"(Manhattan Distance)...\\n\"\n",
        "    )\n",
        "\n",
        "    solution, reached = hill_climbing(state)\n",
        "\n",
        "    if reached:\n",
        "        print(\n",
        "            f\"Goal reached in {len(solution) - 1} steps!\\n\"\n",
        "        )\n",
        "    else:\n",
        "        print(\n",
        "            f\"Stuck at a local optimum after {len(solution) - 1} steps \"\n",
        "            f\"(h = {manhattan(solution[-1])}). Hill climbing failed.\\n\"\n",
        "        )\n",
        "\n",
        "    for step, s in enumerate(solution):\n",
        "        print(f\"Step {step}:\")\n",
        "        print_board(s)\n"
      ]
    }
