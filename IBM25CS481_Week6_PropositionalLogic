          "text": [
            "P Q R | P<->Q | Q AND R | NOT P->R | KB\n",
            "-----------------------------------------------------\n",
            "False False False | True | False | False | False\n",
            "False False True | True | False | True | False\n",
            "False True False | False | False | False | False\n",
            "False True True | False | True | True | False\n",
            "True False False | False | False | True | False\n",
            "True False True | False | False | True | False\n",
            "True True False | True | False | True | False\n",
            "True True True | True | True | True | True\n",
            "\n",
            "Models of KB: [{'P': True, 'Q': True, 'R': True}]\n",
            "\n",
            "KB entails Q: True\n",
            "KB entails P -> Q: True\n",
            "KB entails R -> Q: True\n"
          ]
        }
      ],
      "source": [
        "\n",
        "\n",
        "from itertools import product\n",
        "\n",
        "symbols = ['P', 'Q', 'R']\n",
        "\n",
        "def implies(a, b):\n",
        "    return (not a) or b\n",
        "\n",
        "def check_kb(m):\n",
        "    P, Q, R = m['P'], m['Q'], m['R']\n",
        "\n",
        "    s1 = (P == Q)\n",
        "    s2 = Q and R\n",
        "    s3 = implies(not P, R)\n",
        "\n",
        "    return s1 and s2 and s3\n",
        "\n",
        "def entails(query):\n",
        "    for values in product([False, True], repeat=3):\n",
        "        m = dict(zip(symbols, values))\n",
        "\n",
        "        if check_kb(m) and not query(m):\n",
        "            return False\n",
        "\n",
        "    return True\n",
        "\n",
        "print(\"P Q R | P<->Q | Q AND R | NOT P->R | KB\")\n",
        "print(\"-\" * 53)\n",
        "\n",
        "models = []\n",
        "\n",
        "for values in product([False, True], repeat=3):\n",
        "    m = dict(zip(symbols, values))\n",
        "\n",
        "    P, Q, R = values\n",
        "    s1 = (P == Q)\n",
        "    s2 = Q and R\n",
        "    s3 = implies(not P, R)\n",
        "    kb = check_kb(m)\n",
        "\n",
        "    print(P, Q, R, \"|\", s1, \"|\", s2, \"|\", s3, \"|\", kb)\n",
        "\n",
        "    if kb:\n",
        "        models.append(m)\n",
        "\n",
        "print(\"\\nModels of KB:\", models)\n",
        "\n",
        "print(\"\\nKB entails Q:\", entails(lambda m: m['Q']))\n",
        "\n",
        "print(\"KB entails P -> Q:\",\n",
        "      entails(lambda m: implies(m['P'], m['Q'])))\n",
        "\n",
        "print(\"KB entails R -> Q:\",\n",
        "      entails(lambda m: implies(m['R'], m['Q'])))\n",
        "\n"
      ]
    }
